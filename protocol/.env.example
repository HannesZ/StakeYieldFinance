# StableYield Protocol — Environment Variables

# Deployer private key (never commit with real key!)
DEPLOYER_KEY=0x_your_private_key_here

# RPC URLs
SEPOLIA_RPC_URL=https://sepolia.drpc.org
HOLESKY_RPC_URL=https://ethereum-holesky-rpc.publicnode.com
HOODI_RPC_URL=https://rpc.hoodi.ethpandaops.io

# Set to "true" to deploy MockWstETH instead of using real testnet wstETH
USE_MOCK_WSTETH=false

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=
